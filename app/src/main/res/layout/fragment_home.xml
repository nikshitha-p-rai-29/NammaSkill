<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingTop="12dp">

            <!-- Top row: greeting + notif -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Hello! 👋"
                        android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvDistrict"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📍 Karnataka"
                        android:textColor="#99FFFFFF" android:textSize="12sp" />
                </LinearLayout>

                <ImageButton android:id="@+id/btnNotifications"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:background="@drawable/bg_circle_translucent"
                    android:src="@drawable/ic_notifications"
                    android:tint="@color/white" />
            </LinearLayout>

            <!-- Search bar -->
            <LinearLayout android:id="@+id/searchBar"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/bg_search_bar"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="4dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_search" android:tint="#99FFFFFF" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="10dp"
                    android:text="Search courses, trades, centers..."
                    android:textColor="#80FFFFFF" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Stats row -->
            <androidx.cardview.widget.CardView android:id="@+id/cardStats"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardElevation="2dp"
                android:layout_marginBottom="16dp"
                android:background="@color/navy">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/tvActiveCourses"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="—" android:textColor="@color/white"
                            android:textSize="26sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Active Courses" android:textColor="#99FFFFFF" android:textSize="10sp" android:gravity="center" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#33FFFFFF" android:layout_marginVertical="8dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="38" android:textColor="@color/white"
                            android:textSize="26sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Skill Centers" android:textColor="#99FFFFFF" android:textSize="10sp" android:gravity="center" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#33FFFFFF" android:layout_marginVertical="8dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/tvMyApplications"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/saffron"
                            android:textSize="26sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="My Applications" android:textColor="#99FFFFFF" android:textSize="10sp" android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Banner -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardElevation="2dp"
                android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="18dp"
                    android:background="@drawable/bg_banner_gradient">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="New Batches Starting Soon! 🚀"
                        android:textColor="@color/white" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Welding, Mobile Repair &amp; 3 more in your district"
                        android:textColor="#CCFFFFFF" android:textSize="13sp" android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp" />
                    <Button android:id="@+id/btnExploreAll"
                        android:layout_width="wrap_content" android:layout_height="40dp"
                        android:text="Explore Now →"
                        android:backgroundTint="@color/saffron"
                        android:textColor="@color/white" android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Trade Chips -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="BROWSE BY TRADE" android:textSize="11sp" android:textStyle="bold"
                android:textColor="@color/text_secondary" android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:scrollbars="none" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingBottom="4dp">
                    <com.google.android.material.chip.Chip android:id="@+id/chipAll"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="✨ All" android:layout_marginEnd="8dp" android:checked="true"/>
                    <com.google.android.material.chip.Chip android:id="@+id/chipElectrical"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⚡ Electrical" android:layout_marginEnd="8dp"/>
                    <com.google.android.material.chip.Chip android:id="@+id/chipWelding"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🔥 Welding" android:layout_marginEnd="8dp"/>
                    <com.google.android.material.chip.Chip android:id="@+id/chipSewing"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🧵 Sewing" android:layout_marginEnd="8dp"/>
                    <com.google.android.material.chip.Chip android:id="@+id/chipCoding"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💻 Coding" android:layout_marginEnd="8dp"/>
                    <com.google.android.material.chip.Chip android:id="@+id/chipMobile"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📱 Mobile" android:layout_marginEnd="8dp"/>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Upcoming courses -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="UPCOMING BATCHES" android:textSize="11sp" android:textStyle="bold"
                    android:textColor="@color/text_secondary" android:letterSpacing="0.08" />
                <Button android:id="@+id/btnViewStories"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:text="See Stories ⭐"
                    android:textSize="11sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/saffron"
                    android:textColor="@color/saffron" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvUpcomingCourses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
