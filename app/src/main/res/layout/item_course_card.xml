<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: emoji + title + center -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <androidx.cardview.widget.CardView android:id="@+id/cardEmojiBackground"
                android:layout_width="50dp" android:layout_height="50dp"
                app:cardCornerRadius="12dp" app:cardElevation="0dp"
                android:layout_marginEnd="12dp">
                <TextView android:id="@+id/tvEmoji"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:textSize="24sp" />
            </androidx.cardview.widget.CardView>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvCourseTitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/text_primary" android:lineSpacingMultiplier="1.2" />
                <TextView android:id="@+id/tvCenterName"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tags row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="10dp">

            <TextView android:id="@+id/tvDuration"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_gold"
                android:textSize="11sp" android:textStyle="bold"
                android:paddingHorizontal="8dp" android:paddingVertical="4dp"
                android:layout_marginEnd="6dp" android:textColor="#7B5800" />

            <TextView android:id="@+id/tvJobTag"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_green"
                android:textSize="11sp" android:textStyle="bold"
                android:paddingHorizontal="8dp" android:paddingVertical="4dp"
                android:layout_marginEnd="6dp" android:textColor="#1B5E20" />

            <TextView android:id="@+id/tvLanguage"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_purple"
                android:textSize="11sp" android:textStyle="bold"
                android:paddingHorizontal="8dp" android:paddingVertical="4dp"
                android:textColor="#4527A0" />
        </LinearLayout>

        <!-- Seats tag + progress -->
        <TextView android:id="@+id/tvSeatsTag"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <ProgressBar android:id="@+id/progressSeats"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp"
            android:progressTint="@color/saffron"
            android:progressBackgroundTint="#E0E0E0"
            android:layout_marginBottom="10dp"
            android:progress="60" />

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginBottom="10dp" />

        <!-- Footer: fee + date + apply -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvStartDate"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/tvFee"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textStyle="bold" android:textColor="@color/teal" />
            </LinearLayout>

            <Button android:id="@+id/btnApply"
                android:layout_width="wrap_content" android:layout_height="38dp"
                android:text="Apply Now"
                android:textSize="12sp"
                android:backgroundTint="@color/saffron"
                android:textColor="@color/white"
                android:paddingHorizontal="16dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
